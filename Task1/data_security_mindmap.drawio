                <mxCell id="n5" value="Подмена цены или характеристик объектов в открытых карточках ведёт к срыву сделок и репутационному ущербу; юридических последствий нет — данные изначально публичны." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacing=6;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="1440" y="15" width="460" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="n6" value="Маркетинговые материалы и публичные контакты" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="700" y="165" width="360" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="n7" value="&lt;b&gt;Искажение данных&lt;/b&gt;&lt;br/&gt;&lt;i&gt;Незначительный&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;shadow=0;" parent="1" vertex="1">
